                  "cause": "Adapter failure.",
                  "solution": "Check whether the adapter indicator is off."
                }
              ]
            },
            {
              "problem": "Water leakage",
              "items": [
                {
                  "cause": "Component damage.",
                  "solution": "Turn off the power and close the inlet valve. Contact after-sales support."
                },
                {
                  "cause": "The filter cartridge or water pipe is not connected properly.",
                  "solution": "Check whether the filter cartridge is installed properly and whether the water pipe connection is loose."
                }
              ]
            },
            {
              "problem": "No water",
              "items": [
                {
                  "cause": "Cold water valve or 3-way ball valve is off.",
                  "solution": "Please open the corresponding valve."
                }
              ]
            },
            {
              "problem": "Low water flow",
              "items": [
                {
                  "cause": "Pipe bending.",
                  "solution": "Check inlet, waste, and pure water pipes."
                },
                {
                  "cause": "3-way ball valve is not fully opened.",
                  "solution": "Ensure the inlet 3-way ball valve is completely open."
                },
                {
                  "cause": "Filter cartridge clogging.",
                  "solution": "Replace or contact after-sales personnel."
                }
              ]
            },
            {
              "problem": "Poor water quality",
              "items": [
                {
                  "cause": "Filter cartridge failure.",
                  "solution": "Replace or contact after-sales personnel."
                },
                {
                  "cause": "Poor inlet quality.",
                  "solution": "Please confirm the water quality of tap water and consider installing a pretreatment device."
                }
              ]
            },
            {
              "problem": "Unit keeps restarting",
              "items": [
                {
                  "cause": "The faucet is not fully turned off.",
                  "solution": "Please turn off the faucet."
                },
                {
                  "cause": "Leakage in the pure water outlet pipeline or faucet of the machine.",
                  "solution": "Please replace the leaking parts."
                }
              ]
            }
          ],
          "view": "table"
        }
